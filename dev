#!/bin/sh
# Usage: ./dev <command...>   in the php container
#   ./dev pest --filter=Section      (pest, phpstan, pint and composer are shortcuts)
#   ./dev php -v
#   ./dev php vendor/bin/testbench serve --host=0.0.0.0 --port=8000   (publishes port 8000)
set -e
cd "$(dirname "$0")"

case "$1" in
    pest|phpstan|pint) set -- "vendor/bin/$@" ;;
esac

# Ports publish only for serve, so other commands can run while it is up.
case "$*" in
    *testbench\ serve*) set -- --service-ports php "$@" ;;
    *) set -- php "$@" ;;
esac

exec docker compose run --rm "$@"
