#!/bin/sh
# Usage: uat/run [script ...]   (no argument runs every uat/*.php script)
set -e
cd "$(dirname "$0")/.."

[ $# -eq 0 ] && set -- $(ls uat/*.php | grep -v bootstrap.php | xargs -n1 basename)

for script in "$@"; do
    echo "=== $script"
    docker compose run --rm php php -d zend.assertions=1 "uat/$script"
done
